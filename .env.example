# BrandGuard AI Environment Variables Configuration

# Environment mode: development | staging | production
ENVIRONMENT=development

# Database Connection (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./brandguard.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://brandguard_user:password@localhost:5432/brandguard_db

# Security & Authentication
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev-secret-change-in-production-never-commit-real-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI Provider Configuration
# Set to 'none' for local deterministic checking only
# Supported options: none | gemini | openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Email / OTP verification (SMTP checked first, then Resend, then dev outbox)
# Free option without owning a domain: Gmail app password.
#   1. Enable 2-Step Verification on your Google account
#   2. Create an app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Sender shown in the recipient's inbox (defaults to SMTP_USER if empty)
EMAIL_FROM=BrandGuard <you@gmail.com>
# Alternative: Resend API (test mode only delivers to your own inbox
# unless you verify a custom domain)
RESEND_API_KEY=
# OTP settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Frontend Environment (used when serving or building frontend)
VITE_API_URL=http://localhost:8000/api/v1
