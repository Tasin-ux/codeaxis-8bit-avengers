# BrandGuard AI Environment Variables Configuration

# Environment mode: development | staging | production
ENVIRONMENT=development

# Database Connection (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./brandguard.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://brandguard_user:password@localhost:5432/brandguard_db

# Security & Authentication
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev-secret-change-in-production-never-commit-real-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI Provider Configuration
# Set to 'none' for local deterministic checking only
# Supported options: none | gemini | openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Frontend Environment (used when serving or building frontend)
VITE_API_URL=http://localhost:8000/api/v1
